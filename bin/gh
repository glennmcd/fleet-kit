#!/bin/sh
# fleetwright: runs the real gh with the GitHub App token in FLEETWRIGHT_TOKEN_FILE, read at each call so a
# token renewed mid-run takes effect. Without FLEETWRIGHT_TOKEN_FILE (a review slot, a person) it changes
# nothing. The units put this directory first on PATH.
if [ -n "${FLEETWRIGHT_TOKEN_FILE:-}" ]; then
    GH_TOKEN="$(cat "$FLEETWRIGHT_TOKEN_FILE")" || exit 1
    export GH_TOKEN
fi
exec "${FLEETWRIGHT_REAL_GH:-/usr/bin/gh}" "$@"
