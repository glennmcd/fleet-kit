# Generated by scripts/fleet_slot.py (`fleet_slot.py unit`); a test keeps this file equal to it.
# One allocator pass that prints what it would assign and changes nothing. It runs as the
# allocator, with its token, so the admin who starts it never holds the token:
#   systemctl start fleet-allocate-dry-run; journalctl -u fleet-allocate-dry-run -o cat -n 50
[Unit]
Description=Fleet allocator, dry run: print what a pass would assign
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Its own user in fleet-admin, not root: it writes /var/lib/fleet and starts the slots' units through
# the polkit rule, and can do nothing a member of fleet-admin cannot.
User=fleet-allocator
Slice=fleet.slice
# Files it writes stay group-writable, so the admins can read and fix them.
UMask=0002
# /etc/fleet is root's. systemd reads the config as root and gives the unit a private copy (%d).
LoadCredential=fleet.json:/etc/fleet/fleet.json
Environment=FLEET_CONFIG=%d/fleet.json
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=PATH=/var/lib/fleet-allocator/.local/bin:/usr/local/bin:/usr/bin:/bin
# It only reads GitHub, but without allocator.env it holds the authors' token, which can write. Put a
# read-only token there (GH_TOKEN=...) so a bug in the allocator cannot change the repository.
EnvironmentFile=/etc/fleet/agent.env
EnvironmentFile=-/etc/fleet/allocator.env
ExecStart=/usr/bin/env uv run --script /opt/fleet-kit/scripts/fleet_allocate.py --dry-run
# A hung gh call must not hold the lock and stop every later pass.
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fleet /var/lib/fleet-allocator
PrivateTmp=yes
