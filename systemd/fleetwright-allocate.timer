# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# Enable once /etc/fleetwright/fleetwright.json is written (root): systemctl enable --now fleetwright-allocate.timer
# Pause it as a member of fleetwright-admin: systemctl stop fleetwright-allocate.timer
[Unit]
Description=Run the fleet allocator every 2 minutes

[Timer]
OnBootSec=2min
# Counted from the end of the last pass, so two passes never overlap.
OnUnitInactiveSec=2min
Unit=fleetwright-allocate.service

[Install]
WantedBy=timers.target
