# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# One watchdog pass, with no AI; fleetwright-watchdog.timer runs it. Its lines start with caught or missed, and
# the last one is the run's result: journalctl -u fleetwright-watchdog -o cat -n 30
[Unit]
Description=Fleet watchdog: stalled agents, a red main, stuck pull requests, failed units
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The allocator's user: it reads what the allocator reads and, when main is red, writes the stop flag.
User=fleetwright-allocator
# To read the slots' journal lines, which tell a stalled agent from a working one.
SupplementaryGroups=systemd-journal
Slice=fleetwright.slice
UMask=0002
LoadCredential=fleetwright.json:/etc/fleetwright/fleetwright.json
Environment=FLEETWRIGHT_CONFIG=%d/fleetwright.json
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=PATH=/var/lib/fleetwright-allocator/.local/bin:/usr/local/bin:/usr/bin:/bin
# It only reads GitHub: allocator.env's read-only token replaces the authors' when it is there.
EnvironmentFile=/etc/fleetwright/agent.env
EnvironmentFile=-/etc/fleetwright/allocator.env
ExecStart=/usr/bin/env uv run --script /opt/fleetwright/scripts/fleetwright_watchdog.py
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fleetwright /var/lib/fleetwright-allocator
PrivateTmp=yes
