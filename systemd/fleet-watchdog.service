# Generated by scripts/fleet_slot.py (`fleet_slot.py unit`); a test keeps this file equal to it.
# One watchdog pass, with no AI; fleet-watchdog.timer runs it. Its lines start with caught or missed, and
# the last one is the run's result: journalctl -u fleet-watchdog -o cat -n 30
[Unit]
Description=Fleet watchdog: stalled agents, a red main, stuck pull requests, failed units
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The allocator's user: it reads what the allocator reads and, when main is red, writes the stop flag.
User=fleet-allocator
# To read the slots' journal lines, which tell a stalled agent from a working one.
SupplementaryGroups=systemd-journal
Slice=fleet.slice
UMask=0002
LoadCredential=fleet.json:/etc/fleet/fleet.json
Environment=FLEET_CONFIG=%d/fleet.json
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=PATH=/var/lib/fleet-allocator/.local/bin:/usr/local/bin:/usr/bin:/bin
# It only reads GitHub: allocator.env's read-only token replaces the authors' when it is there.
EnvironmentFile=/etc/fleet/agent.env
EnvironmentFile=-/etc/fleet/allocator.env
ExecStart=/usr/bin/env uv run --script /opt/fleet-kit/scripts/fleet_watchdog.py
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fleet /var/lib/fleet-allocator
PrivateTmp=yes
