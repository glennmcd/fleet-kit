# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# Enable with the allocator's timer (root): systemctl enable --now fleetwright-watchdog.timer
# Pause it as a member of fleetwright-admin: systemctl stop fleetwright-watchdog.timer
[Unit]
Description=Run the fleet watchdog every 5 minutes

[Timer]
OnBootSec=3min
OnUnitInactiveSec=5min
Unit=fleetwright-watchdog.service

[Install]
WantedBy=timers.target
