# Generated by scripts/fleet_slot.py (`fleet_slot.py unit`); a test keeps this file equal to it.
# Enable with the allocator's timer (root): systemctl enable --now fleet-watchdog.timer
# Pause it as a member of fleet-admin: systemctl stop fleet-watchdog.timer
[Unit]
Description=Run the fleet watchdog every 5 minutes

[Timer]
OnBootSec=3min
OnUnitInactiveSec=5min
Unit=fleet-watchdog.service

[Install]
WantedBy=timers.target
