# Generated by scripts/fleet_slot.py (`fleet_slot.py unit`); a test keeps this file equal to it.
# Checks slot %i as its agent would run: same user, secrets and sandbox. Prints no secret.
# As a member of fleet-admin: systemctl start fleet-check-review@review01; journalctl -u fleet-check-review@review01 -o cat
[Unit]
Description=Fleet check of reviewer %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
Slice=fleet.slice
WorkingDirectory=/home/%i/repo
Environment=FLEET_SLOT=%i
Environment=FLEET_ROLE=review
Environment=FLEET_CLONE=/home/%i/repo
Environment=CC_PRACTICES_UNATTENDED=1
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=PATH=/home/%i/.local/bin:/usr/local/bin:/usr/bin:/bin
# The model key from agent.env; the reviewer's GitHub token and expected login from reviewer.env,
# read second so its GH_TOKEN replaces the authors'. Owned by root, mode 600; never in this file.
EnvironmentFile=/etc/fleet/agent.env
EnvironmentFile=/etc/fleet/reviewer.env
ExecStart=/usr/bin/env uv run --script /opt/fleet-kit/scripts/fleet_check.py
TimeoutStartSec=2min
# The slot's user can write its home and a private /tmp, and nothing else. Other homes are closed to it
# by their mode (700), not by this unit.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/%i
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
