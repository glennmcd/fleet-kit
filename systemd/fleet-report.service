# Generated by scripts/fleet_slot.py (`fleet_slot.py unit`); a test keeps this file equal to it.
# The token report over every slot's transcripts, which are mode 600 and owned by the slot. As a member
# of fleet-admin, write the PR data first (the unit has no network), then start it and read its JSON:
#   gh pr list --repo <owner>/<name> --state merged --limit 2000 \
#     --json number,headRefName,mergedAt,additions,deletions > /var/lib/fleet/prs.json
#   systemctl start fleet-report
#   journalctl -o cat _SYSTEMD_INVOCATION_ID=$(systemctl show -p InvocationID --value fleet-report)
[Unit]
Description=Fleet token report over the slots' transcripts

[Service]
Type=oneshot
# Not root: the allocator's user, with only the right to read past file modes, which the transcripts need.
User=fleet-allocator
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
Slice=fleet.slice
Environment=PATH=/var/lib/fleet-allocator/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=UV_OFFLINE=1
# Fixed arguments: whoever starts it cannot point it at another file. It prints totals per week and
# branch, never a transcript's text.
ExecStart=/usr/bin/env uv run --script /opt/fleet-kit/scripts/fleet_report.py --root /home/agent[0-9][0-9]/.claude/projects --root /home/review[0-9][0-9]/.claude/projects --prs /var/lib/fleet/prs.json --json
TimeoutStartSec=5min
# It can read any file, so it gets no secrets and no network, cannot see /etc/fleet, and writes only
# uv's cache.
InaccessiblePaths=/etc/fleet
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/fleet-allocator
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
