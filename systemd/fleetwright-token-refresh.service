# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# Mints a new GitHub App token for every running author slot before its hour is up; the slot's gh and
# git read the file at each call. fleetwright-token-refresh.timer runs it. Each token is a journal line:
#   journalctl -t fleetwright-token -o short-iso -n 20
[Unit]
Description=Fleet: renew the running author slots' GitHub App tokens
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root: it reads the App's key in /etc/fleetwright and writes into each slot's own runtime directory.
Slice=fleetwright.slice
ExecStart=/usr/bin/python3 /opt/fleetwright/scripts/fleetwright_token.py renew
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/fleetwright
PrivateTmp=yes
