# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# The token report over every slot's transcripts, which are mode 600 and owned by the slot. As a member
# of fleetwright-admin, write the PR data first (the unit has no network), then start it and read its JSON:
#   gh pr list --repo <owner>/<name> --state merged --limit 2000 \
#     --json number,headRefName,mergedAt,additions,deletions > /var/lib/fleetwright/prs.json
#   c=$(journalctl -u fleetwright-report -n 0 --show-cursor -q | sed -n 's/^-- cursor: //p')
#   systemctl start fleetwright-report
#   journalctl -u fleetwright-report -o cat --after-cursor "$c" | grep -E '^([{}]| )' > report.json
[Unit]
Description=Fleet token report over the slots' transcripts

[Service]
Type=oneshot
# Not root: the allocator's user, with only the right to read past file modes, which the transcripts need.
User=fleetwright-allocator
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
Slice=fleetwright.slice
Environment=PATH=/var/lib/fleetwright-allocator/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=UV_OFFLINE=1
# Fixed arguments: whoever starts it cannot point it at another file. It prints totals per week and
# branch, never a transcript's text.
ExecStart=/usr/bin/env uv run --script /opt/fleetwright/scripts/fleetwright_report.py --root /home/agent[0-9][0-9]/.claude/projects --root /home/review[0-9][0-9]/.claude/projects --prs /var/lib/fleetwright/prs.json --json
TimeoutStartSec=5min
# It can read any file, so it gets no secrets and no network, cannot see /etc/fleetwright, and writes only
# uv's cache.
InaccessiblePaths=/etc/fleetwright
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/fleetwright-allocator
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
