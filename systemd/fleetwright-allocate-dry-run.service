# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# One allocator pass that prints what it would assign and changes nothing. It runs as the
# allocator, with its token, so the admin who starts it never holds the token:
#   systemctl start fleetwright-allocate-dry-run; journalctl -u fleetwright-allocate-dry-run -o cat -n 50
[Unit]
Description=Fleet allocator, dry run: print what a pass would assign
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Its own user in fleetwright-admin, not root: it writes /var/lib/fleetwright and starts the slots' units through
# the polkit rule, and can do nothing a member of fleetwright-admin cannot.
User=fleetwright-allocator
Slice=fleetwright.slice
# Files it writes stay group-writable, so the admins can read and fix them.
UMask=0002
# /etc/fleetwright is root's. systemd reads the config as root and gives the unit a private copy (%d).
LoadCredential=fleetwright.json:/etc/fleetwright/fleetwright.json
Environment=FLEETWRIGHT_CONFIG=%d/fleetwright.json
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=PATH=/opt/fleetwright/bin:/var/lib/fleetwright-allocator/.local/bin:/usr/local/bin:/usr/bin:/bin
# It only reads GitHub, so its token can only read: a bug in the allocator cannot change the repository.
# Its GitHub App token (read), readable by its user alone: minted as root ('+') before the unit
# starts, the unit ends well inside the token's hour, revoked when it stops (scripts/fleetwright_token.py).
RuntimeDirectory=fleetwright/allocate-dry-run
RuntimeDirectoryMode=0700
Environment=FLEETWRIGHT_TOKEN_FILE=/run/fleetwright/allocate-dry-run/gh-token
ExecStartPre=+/usr/bin/python3 /opt/fleetwright/scripts/fleetwright_token.py mint --mode read --dir /run/fleetwright/allocate-dry-run --owner fleetwright-allocator --unit fleetwright-allocate-dry-run
ExecStopPost=+/usr/bin/python3 /opt/fleetwright/scripts/fleetwright_token.py revoke --dir /run/fleetwright/allocate-dry-run --unit fleetwright-allocate-dry-run
ExecStart=/usr/bin/env uv run --script /opt/fleetwright/scripts/fleetwright_allocate.py --dry-run
# A hung gh call must not hold the lock and stop every later pass.
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fleetwright /var/lib/fleetwright-allocator
PrivateTmp=yes
