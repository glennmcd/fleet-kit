# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# One allocator pass; fleetwright-allocate.timer runs it. To see what it would do, without changing
# anything: systemctl start fleetwright-allocate-dry-run
[Unit]
Description=Fleet allocator: give free slots their next work
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Its own user in fleetwright-admin, not root: it writes /var/lib/fleetwright and starts the slots' units through
# the polkit rule, and can do nothing a member of fleetwright-admin cannot.
User=fleetwright-allocator
Slice=fleetwright.slice
# Files it writes stay group-writable, so the admins can read and fix them.
UMask=0002
# /etc/fleetwright is root's. systemd reads the config as root and gives the unit a private copy (%d).
LoadCredential=fleetwright.json:/etc/fleetwright/fleetwright.json
Environment=FLEETWRIGHT_CONFIG=%d/fleetwright.json
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=PATH=/var/lib/fleetwright-allocator/.local/bin:/usr/local/bin:/usr/bin:/bin
# It only reads GitHub, but without allocator.env it holds the authors' token, which can write. Put a
# read-only token there (GH_TOKEN=...) so a bug in the allocator cannot change the repository.
EnvironmentFile=/etc/fleetwright/agent.env
EnvironmentFile=-/etc/fleetwright/allocator.env
ExecStart=/usr/bin/env uv run --script /opt/fleetwright/scripts/fleetwright_allocate.py
# A hung gh call must not hold the lock and stop every later pass.
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fleetwright /var/lib/fleetwright-allocator
PrivateTmp=yes
