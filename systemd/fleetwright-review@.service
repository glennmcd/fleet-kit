# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# The allocator starts it; by hand, as a member of fleetwright-admin: systemctl start fleetwright-review@review01
[Unit]
Description=Fleet reviewer %i
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=%i
Slice=fleetwright-review.slice
WorkingDirectory=/home/%i/repo
Environment=FLEETWRIGHT_SLOT=%i
Environment=FLEETWRIGHT_ROLE=review
Environment=FLEETWRIGHT_CLONE=/home/%i/repo
Environment=CC_PRACTICES_UNATTENDED=1
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=PATH=/home/%i/.local/bin:/usr/local/bin:/usr/bin:/bin
# The model key from agent.env; the reviewer's GitHub token and expected login from reviewer.env,
# read second so its GH_TOKEN replaces the authors'. Owned by root, mode 600; never in this file.
EnvironmentFile=/etc/fleetwright/agent.env
EnvironmentFile=/etc/fleetwright/reviewer.env
ExecStart=/usr/bin/env uv run --script /opt/fleetwright/scripts/fleetwright_agent.py
# One run per assignment: the allocator starts the unit again, not systemd.
Restart=no
TimeoutStopSec=30
# The slot's user can write its home and a private /tmp, and nothing else. Other homes are closed to it
# by their mode (700), not by this unit.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/%i
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
