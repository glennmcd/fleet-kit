# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# Checks slot %i as its agent would run: same user, secrets and sandbox. Prints no secret.
# As a member of fleetwright-admin: systemctl start fleetwright-check-agent@agent01; journalctl -u fleetwright-check-agent@agent01 -o cat
[Unit]
Description=Fleet check of agent %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
Slice=fleetwright.slice
WorkingDirectory=/home/%i/repo
Environment=FLEETWRIGHT_SLOT=%i
Environment=FLEETWRIGHT_ROLE=author
Environment=FLEETWRIGHT_CLONE=/home/%i/repo
Environment=CC_PRACTICES_UNATTENDED=1
Environment=GH_NO_UPDATE_NOTIFIER=1
# claude -p is the main session: hold it to the context ceiling and the wait cap.
Environment=CONTEXT_CEILING_MAIN=1
Environment=WAIT_CAP_MAIN=1
# /opt/fleetwright/bin first: its gh reads the token file at each call, so a renewed token takes effect.
Environment=PATH=/opt/fleetwright/bin:/home/%i/.local/bin:/usr/local/bin:/usr/bin:/bin
# Beside the clone, what the write guard allows; the sandbox allows the same (managed-settings.json).
Environment=FLEETWRIGHT_ALLOW_WRITE=/home/%i/.cache:/home/%i/.local/share/uv:/home/%i/.bun
# The model key. Owned by root, mode 600; never in this file. GitHub is the App's token below.
EnvironmentFile=/etc/fleetwright/agent.env
# Its GitHub App token (write), readable by its user alone: minted as root ('+') before the unit
# starts, the unit ends well inside the token's hour, revoked when it stops (scripts/fleetwright_token.py).
RuntimeDirectory=fleetwright/check-%i
RuntimeDirectoryMode=0700
Environment=FLEETWRIGHT_TOKEN_FILE=/run/fleetwright/check-%i/gh-token
ExecStartPre=+/usr/bin/python3 /opt/fleetwright/scripts/fleetwright_token.py mint --mode write --dir /run/fleetwright/check-%i --owner %i --slot %i
ExecStopPost=+/usr/bin/python3 /opt/fleetwright/scripts/fleetwright_token.py revoke --dir /run/fleetwright/check-%i --slot %i
ExecStart=/usr/bin/env uv run --script /opt/fleetwright/scripts/fleetwright_check.py
TimeoutStartSec=2min
# The slot's user can write its home and a private /tmp, and nothing else. Other homes are closed to it
# by their mode (700), not by this unit.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/%i
PrivateTmp=yes
PrivateDevices=yes
# No ProtectKernelTunables: it mounts over parts of /proc, and the kernel then refuses Claude Code's
# sandbox a /proc of its own, so every command fails with "Can't mount proc". The slot's user cannot
# write /proc/sys anyway.
ProtectControlGroups=yes
