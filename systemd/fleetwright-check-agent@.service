# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# Checks slot %i as its agent would run: same user, secrets and sandbox. Prints no secret.
# As a member of fleetwright-admin: systemctl start fleetwright-check-agent@agent01; journalctl -u fleetwright-check-agent@agent01 -o cat
[Unit]
Description=Fleet check of agent %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
Slice=fleetwright.slice
WorkingDirectory=/home/%i/repo
Environment=FLEETWRIGHT_SLOT=%i
Environment=FLEETWRIGHT_ROLE=author
Environment=FLEETWRIGHT_CLONE=/home/%i/repo
Environment=CC_PRACTICES_UNATTENDED=1
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=PATH=/home/%i/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets (the model key, the GitHub token). Owned by root, mode 600; never in this file.
EnvironmentFile=/etc/fleetwright/agent.env
ExecStart=/usr/bin/env uv run --script /opt/fleetwright/scripts/fleetwright_check.py
TimeoutStartSec=2min
# The slot's user can write its home and a private /tmp, and nothing else. Other homes are closed to it
# by their mode (700), not by this unit.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/%i
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
