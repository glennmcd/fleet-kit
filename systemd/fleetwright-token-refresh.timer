# Generated by scripts/fleetwright_slot.py (`fleetwright_slot.py unit`); a test keeps this file equal to it.
# Enable once the App is set up (root): systemctl enable --now fleetwright-token-refresh.timer
# A token lives an hour; every 20 minutes leaves two tries before one runs out.
[Unit]
Description=Renew the running author slots' GitHub App tokens every 20 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=20min
Unit=fleetwright-token-refresh.service

[Install]
WantedBy=timers.target
